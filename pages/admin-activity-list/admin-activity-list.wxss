page {
  background-color: #F7F8FA;
}

.page-container {
  padding: 30rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.list-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F6F8;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.status-tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-active {
  background: #E8F9F0;
  color: #07C160;
}

.status-ended {
  background: #F5F5F5;
  color: #999;
}

.card-body {
  margin-bottom: 20rpx;
}

.info-row {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.edit-hint {
  font-size: 24rpx;
  color: #07C160;
}

.delete-btn {
  font-size: 24rpx;
  color: #FA5151;
  padding: 8rpx 16rpx;
  background: #FEF0F0;
  border-radius: 8rpx;
}