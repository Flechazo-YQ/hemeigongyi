<custom-loading show="{{loading}}" />
<view class="page-container">
  <view class="header">
    <view class="header-row">
      <view>
        <text class="title">{{title}}</text>
        <text class="subtitle">共 {{list.length}} 人报名</text>
      </view>
      <button class="export-btn" bindtap="exportRegistrations" loading="{{exporting}}" disabled="{{exporting}}">导出</button>
    </view>
  </view>

  <scroll-view scroll-y class="list-container">
    <block wx:if="{{list.length > 0}}">
      <view class="card" wx:for="{{list}}" wx:key="_id" bindtap="showDetail" data-item="{{item}}">
        <view class="card-main">
          <view class="user-info">
            <text class="name">{{item.name || item.child_name || item.volunteerName}}</text>
            <text class="gender tag">{{item.gender || item.child_gender || item.volunteerGender}}</text>
          </view>
          <view class="contact">
            <text>{{item.phone || item.parent_phone || item.volunteerPhone}}</text>
          </view>
        </view>
        <view class="card-status {{item.status === '已通过' ? 'status-approved' : (item.status === '已拒绝' ? 'status-rejected' : 'status-pending')}}">
          {{item.status || '待审核'}}
        </view>
        <view class="card-arrow">></view>
      </view>
    </block>
    <block wx:else>
      <empty-placeholder show="{{true}}" text="暂无报名信息" />
    </block>
  </scroll-view>

  <!-- Detail Popup -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideDetail">
    <view class="modal-content" catchtap="stopProp">
      <view class="modal-header">
        <text>报名详情</text>
        <view class="close-btn" bindtap="hideDetail">×</view>
      </view>
      <scroll-view scroll-y class="modal-body">
        <block wx:if="{{selectedItem.sourceCollection === 'volunteer_registrations'}}">
           <view class="info-item">
             <text class="label">姓名</text>
             <text class="value">{{selectedItem.volunteerName}}</text>
           </view>
           <view class="info-item">
             <text class="label">性别</text>
             <text class="value">{{selectedItem.volunteerGender}}</text>
           </view>
           <view class="info-item">
             <text class="label">手机号</text>
             <text class="value">{{selectedItem.volunteerPhone}}</text>
           </view>
           <view class="info-item">
             <text class="label">学号</text>
             <text class="value">{{selectedItem.studentId}}</text>
           </view>
           <view class="info-item">
             <text class="label">学院</text>
             <text class="value">{{selectedItem.college}}</text>
           </view>
           <view class="info-item">
             <text class="label">专业班级</text>
             <text class="value">{{selectedItem.major}}</text>
           </view>
           <view class="info-item">
             <text class="label">政治面貌</text>
             <text class="value">{{selectedItem.politicalStatus}}</text>
           </view>
           <view class="info-item" wx:if="{{selectedItem.volunteerSkills}}">
             <text class="label">特长/技能</text>
             <text class="value">{{selectedItem.volunteerSkills}}</text>
           </view>
        </block>
        <block wx:else>
           <view class="info-item">
             <text class="label">儿童姓名</text>
             <text class="value">{{selectedItem.child_name}}</text>
           </view>
           <view class="info-item">
             <text class="label">性别</text>
             <text class="value">{{selectedItem.child_gender}}</text>
           </view>
           <view class="info-item">
             <text class="label">年龄</text>
             <text class="value">{{selectedItem.child_age}}岁</text>
           </view>
           <view class="info-item">
             <text class="label">家长手机</text>
             <text class="value">{{selectedItem.parent_phone}}</text>
           </view>
        </block>
        <view class="info-item">
             <text class="label">报名时间</text>
             <text class="value">{{selectedItem.createTimeStr}}</text>
        </view>
        
        <!-- 审核意见输入框 -->
        <view class="audit-reason-box">
          <text class="label">审核意见 (选填)</text>
          <textarea class="reason-input" placeholder="请输入通过或拒绝的原因..." bindinput="onReasonInput" value="{{auditReason}}" fixed="true" cursor-spacing="100"></textarea>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-reject" bindtap="handleReject">拒绝</button>
        <button class="btn-approve" bindtap="handleApprove">同意</button>
      </view>
    </view>
  </view>
</view>
