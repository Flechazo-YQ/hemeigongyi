<custom-loading show="{{loading}}" />
<view class="page-container">
  <view class="header">
    <view class="header-row">
      <view class="header-info">
        <text class="title">{{title}}</text>
        <text class="subtitle">共 {{list.length}} 人报名</text>
      </view>
      <button class="export-btn" size="mini" hover-class="export-btn-pressed" bindtap="exportRegistrations" loading="{{exporting}}" disabled="{{exporting}}">导出</button>
    </view>
  </view>

  <scroll-view scroll-y class="list-container">
    <block wx:if="{{list.length > 0}}">
      <view class="card" wx:for="{{list}}" wx:key="_id" bindtap="showDetail" data-item="{{item}}">
        <view class="card-main">
          <view class="user-info">
            <text class="name">{{item.displayName}}</text>
            <text class="gender tag">{{item.displayGender}}</text>
          </view>
          <view class="contact">
            <text>{{item.displayPhone}}</text>
          </view>
        </view>
        <view class="card-status {{item.status === '已通过' ? 'status-approved' : (item.status === '已拒绝' ? 'status-rejected' : 'status-pending')}}">
          {{item.status || '待审核'}}
        </view>
        <view class="card-arrow">></view>
      </view>
    </block>
    <block wx:else>
      <empty-placeholder show="{{true}}" text="暂无报名信息" />
    </block>
  </scroll-view>

  <!-- Detail Popup -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideDetail">
    <view class="modal-content" catchtap="stopProp">
      <view class="modal-header">
        <text>报名详情</text>
        <view class="close-btn" bindtap="hideDetail">×</view>
      </view>
      <scroll-view scroll-y class="modal-body">
        <view class="info-item">
          <text class="label">姓名</text>
          <text class="value">{{selectedItem.displayName}}</text>
        </view>
        <view class="info-item">
          <text class="label">性别</text>
          <text class="value">{{selectedItem.displayGender}}</text>
        </view>
        <view class="info-item">
          <text class="label">年龄</text>
          <text class="value">{{selectedItem.displayAge}}</text>
        </view>
        <view class="info-item">
          <text class="label">手机号</text>
          <text class="value">{{selectedItem.displayPhone}}</text>
        </view>
        <view class="info-item">
             <text class="label">报名时间</text>
             <text class="value">{{selectedItem.createTimeStr}}</text>
        </view>
        
        <!-- 审核意见输入框 -->
        <view class="audit-reason-box">
          <text class="label">审核意见（选填）</text>
          <textarea class="reason-input" placeholder="同意可留空；拒绝时必须填写审核意见" bindinput="onReasonInput" value="{{auditReason}}" disabled="{{submitting}}" fixed="true" cursor-spacing="100"></textarea>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-reject" bindtap="handleReject" disabled="{{submitting}}">拒绝</button>
        <button class="btn-approve" bindtap="handleApprove" disabled="{{submitting}}">同意</button>
      </view>
    </view>
  </view>
</view>
