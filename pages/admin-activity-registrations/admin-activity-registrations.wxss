.page-container {
  padding: 20rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.header {
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.export-btn {
  margin: 0;
  min-width: 128rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  border: 1rpx solid #07c160;
  border-radius: 8rpx;
  background: #fff;
  color: #07c160;
  font-size: 26rpx;
}

.list-container {
  height: calc(100vh - 150rpx);
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.card-main {
  flex: 1;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  background: #e6f7ff;
  color: #1890ff;
  border-radius: 8rpx;
}

.contact {
  font-size: 28rpx;
  color: #666;
}

.card-arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 20rpx;
}

.card-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
}

.status-pending {
  background: #fff7e6;
  color: #fa8c16;
}

.status-approved {
  background: #f6ffed;
  color: #52c41a;
}

.status-rejected {
  background: #fff1f0;
  color: #f5222d;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
  position: relative;
}

.close-btn {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  font-size: 40rpx;
  line-height: 1;
  color: #999;
}

.modal-body {
  padding: 30rpx;
  overflow-y: auto;
}

.info-item {
  margin-bottom: 24rpx;
  display: flex;
}

.label {
  width: 160rpx;
  color: #666;
  font-size: 28rpx;
}

.value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
}

.modal-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
}

.modal-footer button {
  width: 45%;
  font-size: 30rpx;
  border-radius: 40rpx;
  margin: 0;
}

.btn-reject {
  background: #f5f5f5;
  color: #666;
}

.btn-approve {
  background: #07c160;
  color: #fff;
}

/* Audit Reason Box */
.audit-reason-box {
  margin-top: 30rpx;
  border-top: 1rpx dashed #eee;
  padding-top: 20rpx;
}

.reason-input {
  width: 100%;
  height: 160rpx;
  background: #f9f9f9;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 15rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-top: 10rpx;
}
