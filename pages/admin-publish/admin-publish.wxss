page {
  background-color: #F7F8FA;
}

.page-container {
  padding: 30rpx;
  padding-bottom: 120rpx; /* Space for fixed footer if needed, or just bottom spacing */
}

.header-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
  padding-left: 10rpx;
}

.publish-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.form-group {
  margin-bottom: 40rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #FA5151;
  margin-left: 8rpx;
}

.input {
  background: #F5F6F8;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  height: 88rpx;
  box-sizing: border-box;
}

.static-value {
  background: #F5F6F8;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.picker-view {
  background: #F5F6F8;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  height: 88rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.time-picker-area {
  background: #F5F6F8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.picker-item {
  background: #FFFFFF;
  border-radius: 8rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
}

.date-picker {
  flex: 3;
}

.time-picker {
  flex: 2;
}

.picker-inner {
  width: 100%;
  text-align: center;
}

.picker-separator {
  color: #999;
  margin: 0 10rpx;
  font-weight: bold;
}

.add-time-btn {
  background: #E8F9F0;
  color: #07C160;
  font-size: 28rpx;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-weight: 600;
}

.time-slots-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.time-slot-item {
  background: #F0F9EB;
  border: 1rpx solid #E1F3D8;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.slot-text {
  font-size: 26rpx;
  color: #333;
}

.delete-btn {
  font-size: 24rpx;
  color: #FA5151;
  padding: 8rpx 16rpx;
}

.empty-slots-tip {
  font-size: 24rpx;
  color: #FA5151;
  margin-top: 10rpx;
}

.textarea {
  background: #F5F6F8;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
  line-height: 1.5;
}

.placeholder {
  color: #C0C4CC;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #C0C4CC;
  margin-top: 12rpx;
}

.footer-action {
  margin-top: 60rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #07C160 0%, #10AD57 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 12rpx 24rpx rgba(7, 193, 96, 0.3);
  border: none;
}

.submit-btn::after {
  border: none;
}

.btn-hover {
  opacity: 0.9;
  transform: scale(0.98);
}
.time-picker-group {
  display: flex;
  gap: 20rpx;
}

.time-picker-group picker {
  flex: 1;
}

.date-picker, .time-picker {
  width: 100%;
}

