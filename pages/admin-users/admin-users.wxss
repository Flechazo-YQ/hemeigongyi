/* pages/admin-users/admin-users.wxss */
page {
  background-color: #F4F6F9;
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

.admin-users-page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  box-sizing: border-box;
}

/* 顶部搜索区 */
.header-section {
  width: 100%;
  padding: 20rpx 30rpx 10rpx;
  background: #fff;
  box-sizing: border-box;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #F2F4F7;
  border-radius: 40rpx;
  padding: 0 30rpx;
  height: 72rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  transition: all 0.3s ease;
}

.search-box:focus-within {
  background-color: #fff;
  border: 1rpx solid #D84315;
  box-shadow: 0 4rpx 12rpx rgba(216, 67, 21, 0.1);
}

.search-icon {
  margin-right: 16rpx;
}

.clear-icon {
  margin-left: 16rpx;
  padding: 10rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.ph-style {
  color: #999;
}

/* 分段控制器 */
.segment-container {
  width: 100%;
  padding: 20rpx 40rpx;
  background: #fff;
  border-bottom: 1rpx solid #EAECEF;
  z-index: 10;
  box-sizing: border-box;
}

.segment-box {
  position: relative;
  display: flex;
  background-color: #F2F4F7;
  border-radius: 16rpx;
  height: 72rpx;
  padding: 4rpx;
  box-sizing: border-box;
}

.segment-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  z-index: 2;
  border-radius: 12rpx;
  transition: color 0.3s ease;
}

.segment-item.active {
  color: #333;
  font-weight: 600;
}

.segment-slider {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: calc(50% - 4rpx);
  height: calc(100% - 8rpx);
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s cubic-bezier(0.645, 0.045, 0.355, 1);
  z-index: 1;
}

/* 内容区 */
.content-wrapper {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.content-view {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.az-scroll {
  height: 100%;
}

.group-title, .alpha-group-title {
  padding: 24rpx 30rpx 12rpx;
  font-size: 26rpx;
  color: #8C98A4;
  font-weight: 600;
}

/* 卡片列表 */
.card-list {
  padding: 0 30rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card-hover {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  background-color: #fafafa;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #F0F2F5;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.name {
  font-size: 32rpx;
  color: #2C3E50;
  font-weight: 600;
  margin-right: 16rpx;
}

.role-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.role-admin {
  background-color: #FFF0F0;
  color: #E53935;
  border: 1rpx solid #FFCDD2;
}

.role-publisher {
  background-color: #E3F2FD;
  color: #1E88E5;
  border: 1rpx solid #BBDEFB;
}

.role-user {
  display: none;
}

.phone {
  font-size: 24rpx;
  color: #8C98A4;
  font-weight: 500;
}

.action-arrow {
  font-size: 28rpx;
  color: #C7C7CC;
  margin-left: 20rpx;
  font-weight: bold;
}

/* 空状态与加载中 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.3;
  margin-bottom: 30rpx;
}

.empty-state text {
  font-size: 28rpx;
  color: #999;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 150rpx;
  color: #999;
  font-size: 28rpx;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #EAECEF;
  border-top-color: #D84315;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 侧边字母导航栏 */
.alphabet-nav {
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
  background: rgba(255,255,255,0.7);
  backdrop-filter: blur(10px);
  padding: 10rpx 0;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.alpha-item {
  font-size: 20rpx;
  color: #555;
  padding: 6rpx 14rpx;
  font-weight: 700;
  font-family: -apple-system, sans-serif;
}

.alpha-item:active {
  color: #D84315;
  background-color: rgba(216, 67, 21, 0.1);
  border-radius: 50%;
}

.bottom-placeholder {
  height: 120rpx;
}
