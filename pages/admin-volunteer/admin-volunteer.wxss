/* pages/admin-volunteer/admin-volunteer.wxss */
page {
  background-color: #F7F8FA;
  height: 100%;
}

.page-container {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  position: relative;
  padding-bottom: 20rpx;
  font-weight: 500;
}

.tab-item.active {
  font-weight: bold;
  font-size: 36rpx;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 6rpx;
  background: #333; /* 黑色下划线，参考截图 */
  border-radius: 3rpx;
}

/* Scroll View */
.content-scroll {
  flex: 1;
  height: 0; /* Flex trick */
}

.activity-list {
  padding: 20rpx 30rpx;
}

/* Activity Card */
.activity-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #FA5151;
  color: #fff;
  font-size: 24rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
  z-index: 1;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-right: 40rpx; /* Avoid overlap with arrow */
}

.activity-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #000;
  flex: 1;
  margin-right: 20rpx;
}

.status-tag {
  font-size: 26rpx;
  color: #999;
}

.status-active {
  color: #FA5151; /* 招募中 红色 */
}

.status-end {
  color: #999;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.info-row {
  font-size: 28rpx;
  color: #333;
}

.info-text {
  line-height: 1.5;
}

.card-arrow {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}

.arrow-icon {
  color: #ccc;
  font-size: 32rpx;
  font-family: monospace; /* Make > look standard */
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* List Items */
.list-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.volunteer-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F6F8;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-placeholder {
  width: 60rpx;
  height: 60rpx;
  background: #E0E0E0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFF;
  margin-right: 20rpx;
  font-weight: bold;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.time-tag {
  font-size: 24rpx;
  color: #999;
}

.card-body {
  padding-left: 10rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  font-size: 28rpx;
  color: #666;
  width: 160rpx;
}

.info-row .value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.load-more-wrap {
  text-align: center;
  padding: 40rpx 0;
  color: #07C160;
  font-size: 28rpx;
}
