/* pages/signup/signup.wxss */
page {
  background-color: #F8F9FB; /* lighter, cleaner background */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  color: #1F2937;
}

.container {
  padding: 0 0 180rpx 0; /* Space for bottom fixed button */
  min-height: 100vh;
  box-sizing: border-box;
}

/* Header Section */
.header-section {
  background: white;
  padding: 40rpx 40rpx 50rpx;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 20rpx;
}

.header-label {
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
  letter-spacing: 0.5px;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
  display: block;
}

/* Form Section */
.form-section {
  padding: 0;
}

.form-group {
  background: white;
  border-radius: 0;
  padding: 10rpx 40rpx;
  margin-bottom: 20rpx;
}

.form-item {
  position: relative;
  padding: 32rpx 0;
  border-bottom: 1px solid #F3F4F6;
  display: flex;
  align-items: center;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #374151;
  flex-shrink: 0;
}

.required::after {
  content: '*';
  color: #EF4444;
  margin-left: 4rpx;
}

.input-area {
  flex: 1;
}

.input {
  width: 100%;
  font-size: 30rpx;
  color: #111827;
  height: 48rpx;
  line-height: 48rpx;
}

.placeholder {
  color: #9CA3AF;
  font-size: 30rpx;
}

.picker {
  width: 100%;
  font-size: 30rpx;
  color: #111827;
  height: 48rpx;
  line-height: 48rpx;
}

.picker.empty {
  color: #9CA3AF;
}

.picker-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
}

/* Skills Textarea special styling */
.form-group-vertical {
  background: white;
  border-radius: 0;
  padding: 40rpx 40rpx;
  margin-bottom: 20rpx;
}

.label-vertical {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 24rpx;
}

.textarea-wrapper {
  background: #F9FAFB;
  border-radius: 20rpx;
  padding: 24rpx;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  font-size: 30rpx;
  color: #111827;
  line-height: 1.5;
}

/* Bottom Button */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
}

.submit-btn {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: white;
  font-size: 34rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.3);
  transition: all 0.2s ease;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(37, 99, 235, 0.2);
}