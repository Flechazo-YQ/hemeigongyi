/* pages/ar-learning/ar-learning.wxss */

.page-container {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

/* 相机区域 (80%) */
.camera-section {
  width: 100%;
  height: 80vh; /* 占据80%视口高度 */
  position: relative;
  background: #000;
  flex-shrink: 0;
}

.fullscreen-camera {
  width: 100%;
  height: 100%;
}

/* 底部控制栏 (20%) */
.control-bar {
  width: 100%;
  height: 20vh; /* 占据20%视口高度 */
  background: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  flex-shrink: 0;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom)); /* 增加底部内边距，避开TabBar */
  box-sizing: border-box;
}

/* 拍摄按钮 */
.shutter-button-outer {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f0f0f0; /* 浅灰外圈 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.shutter-button-inner {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #000000;
  border: 4rpx solid #ffffff;
}

.shutter-button-outer:active .shutter-button-inner {
  transform: scale(0.9);
  background: #333;
}

/* 翻转按钮 */
.flip-btn {
  position: absolute;
  right: 60rpx;
  /* 垂直居中于内容区域 (需要考虑padding) */
  top: 50%;
  transform: translateY(calc(-50% - 55rpx)); /* 向上偏移padding的一半 */
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.05); /* 极淡的背景 */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flip-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.8;
}

.flip-btn:active {
  background: rgba(0, 0, 0, 0.1);
}

/* 启动页/占位符 */
.camera-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.placeholder-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.placeholder-icon {
  font-size: 100rpx;
  margin-bottom: 40rpx;
}

.placeholder-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 60rpx;
}

.start-btn {
  background: #000000;
  color: #ffffff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.1);
}

.start-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 快照预览 */
.snapshot-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
}

.snapshot-controls {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 11;
}

.retake-btn {
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 40rpx;
  padding: 15rpx 40rpx;
  font-size: 28rpx;
  backdrop-filter: blur(10rpx);
}

/* 结果区域 */
.result-section {
  padding: 40rpx;
  background: #ffffff;
  min-height: 60vh; /* 保证有足够空间滚动 */
  padding-bottom: 150rpx; /* 增加底部内边距，防止被 TabBar 遮挡 */
}

.result-header {
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 20rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
}

.recognition-result {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-item.description {
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  min-width: 140rpx;
}

.value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
}

.value.primary {
  font-size: 36rpx;
  font-weight: 700;
  color: #000;
}

.value.desc-text {
  text-align: left;
  line-height: 1.6;
  color: #444;
}

.confidence-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  justify-content: flex-end;
}

.confidence-wrapper progress {
  width: 150rpx;
}

/* 更多结果 */
.more-results {
  margin-top: 60rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid #f0f0f0;
}

.more-header {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-item-small {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.small-keyword {
  font-size: 28rpx;
  color: #333;
}

.small-score {
  font-size: 26rpx;
  color: #666;
}