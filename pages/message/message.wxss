.page-container {
  min-height: 100vh;
  background-color: #f7f7f7;
  padding: 20rpx;
  padding-bottom: 150rpx; /* Space for tabbar */
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.message-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.tag-volunteer {
  background: #e6f7ff;
  color: #1890ff;
}

.tag-study {
  background: #f6ffed;
  color: #52c41a;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.status-badge {
  font-size: 26rpx;
  font-weight: bold;
}

.status-pending {
  color: #fa8c16;
}

.status-approved {
  color: #52c41a;
}

.status-rejected {
  color: #f5222d;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.sub-info {
  font-size: 28rpx;
  color: #666;
}

.card-footer {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #eee;
}

.reject-reason {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}