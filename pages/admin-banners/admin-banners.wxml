<custom-loading show="{{loading}}" />

<view class="page-container">
  <!-- 头部信息 -->
  <view class="header">
    <view class="title">往期精彩管理</view>
    <view class="subtitle">管理首页的轮播图，建议上传 16:9 横屏高清图片</view>
  </view>

  <!-- 列表区域 -->
  <view class="banner-list" wx:if="{{banners.length > 0}}">
    <block wx:for="{{banners}}" wx:key="_id">
      <view class="banner-card">
        <image class="banner-image" src="{{item.url}}" mode="aspectFill"></image>
        <view class="banner-content">
          <view class="banner-text-box">
            <text class="banner-title">{{item.title || '（未设置标题）'}}</text>
            <text class="banner-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
            <text class="banner-link">🔗 {{item.link || '无跳转链接'}}</text>
          </view>
          <view class="banner-actions">
            <block wx:if="{{!item.isHardcoded}}">
              <button size="mini" class="edit-btn" bindtap="editBanner" data-id="{{item._id}}">编辑</button>
              <button size="mini" class="delete-btn" bindtap="deleteBanner" data-id="{{item._id}}">删除</button>
            </block>
            <view wx:else class="hardcoded-badge">固定展示 (系统内置)</view>
          </view>
        </view>
      </view>
    </block>
  </view>
  
  <view wx:else class="empty-state">
    <text>暂无内容，请点击下方按钮添加</text>
  </view>

  <!-- 底部悬浮添加按钮 -->
  <view class="add-button-area">
    <button class="add-button-primary" bindtap="showAddModal">
      <text class="add-icon">+</text> 添加新轮播图
    </button>
  </view>

  <!-- 添加弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideAddModal">
    <view class="modal-card" catchtap="preventBubble">
      <view class="modal-title">{{editingId ? '编辑往期活动' : '新增轮播图'}}</view>
      
      <scroll-view scroll-y class="modal-scroll">
        <view class="form-group">
          <text class="form-label">上传图片 (必填)</text>
          <view class="image-uploader" bindtap="chooseImage">
            <image wx:if="{{tempImgUrl}}" src="{{tempImgUrl}}" mode="aspectFill" class="uploaded-image"></image>
            <view wx:else class="upload-prompt">
              <view class="upload-plus">+</view>
              <text>点击选择图片</text>
            </view>
          </view>
        </view>

        <view class="form-group">
          <text class="form-label">大标题</text>
          <input class="form-input" placeholder="例如：世界UCI自行车赛" value="{{tempTitle}}" bindinput="inputTitle" />
        </view>
        
        <view class="form-group">
          <text class="form-label">小标题</text>
          <input class="form-input" placeholder="例如：千岛湖站" value="{{tempSubtitle}}" bindinput="inputSubtitle" />
        </view>

        <view class="form-group">
          <text class="form-label">左上角角标 (选填)</text>
          <input class="form-input" placeholder="例如：热门活动、爱心公益" value="{{tempTag}}" bindinput="inputTag" />
        </view>
        
        <view class="form-group">
          <text class="form-label">跳转链接 (选填)</text>
          <input class="form-input" maxlength="8192" placeholder="粘贴已发布的公众号文章完整链接" value="{{tempLink}}" bindinput="inputLink" />
        </view>
      </scroll-view>

      <view class="modal-actions">
        <button class="btn-cancel" disabled="{{submitting}}" bindtap="hideAddModal">取消</button>
        <button class="btn-confirm" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitBanner">{{submitting ? '保存中' : (editingId ? '保存修改' : '确认添加')}}</button>
      </view>
    </view>
  </view>
</view>
