<custom-loading show="{{loading}}" />

<view class="container">
  <view class="header">
    <text class="title">往期精彩管理</text>
    <text class="subtitle">建议上传 16:9 横屏图片</text>
  </view>

  <!-- 列表区域 -->
  <view class="banner-list">
    <block wx:for="{{banners}}" wx:key="_id">
      <view class="banner-item">
        <image class="banner-img" src="{{item.url}}" mode="aspectFill"></image>
        <view class="banner-info">
          <text class="banner-link" selectable>跳转: {{item.link || '无链接'}}</text>
          <view class="delete-btn" bindtap="deleteBanner" data-id="{{item._id}}">删除</view>
        </view>
      </view>
    </block>
    <view wx:if="{{banners.length === 0}}" class="no-data">暂无数据</view>
  </view>

  <!-- 添加按钮 -->
  <view class="add-btn-wrapper">
    <button class="add-btn" bindtap="showAddModal">添加新内容</button>
  </view>

  <!-- 添加弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideAddModal">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-header">添加往期精彩</view>
      
      <view class="form-item">
        <text class="label">图片</text>
        <view class="upload-box" bindtap="chooseImage">
          <image wx:if="{{tempImgUrl}}" src="{{tempImgUrl}}" mode="aspectFill" class="preview-img"></image>
          <view wx:else class="upload-placeholder">
            <text class="plus">+</text>
            <text>点击上传图片</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="label">跳转链接 (公众号文章)</text>
        <input class="input" placeholder="请输入链接" value="{{tempLink}}" bindinput="inputLink" />
      </view>

      <view class="modal-footer">
        <button class="btn cancel" bindtap="hideAddModal">取消</button>
        <button class="btn confirm" bindtap="submitBanner">确定</button>
      </view>
    </view>
  </view>
</view>