.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
  display: block;
}

.banner-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.banner-item {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.banner-img {
  width: 100%;
  height: 300rpx;
  background: #eee;
}

.banner-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.banner-msg {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.banner-link {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.delete-btn {
  color: #ff4d4f;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
}

.no-data {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
}

.add-btn-wrapper {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.add-btn {
  background: #A62F39;
  color: #fff;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(166, 47, 57, 0.3);
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.modal-header {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 10rpx;
  color: #333;
}

.upload-box {
  width: 100%;
  height: 300rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.plus {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.input {
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn {
  flex: 1;
  font-size: 28rpx;
}

.cancel {
  background: #f5f5f5;
  color: #666;
}

.confirm {
  background: #A62F39;
  color: #fff;
}