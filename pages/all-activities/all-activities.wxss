.page-container {
  background-color: #f7f7f7;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  position: relative;
  padding-bottom: 10rpx;
}

.tab-item.active {
  color: #1890ff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

.list-container {
  padding: 20rpx;
  height: calc(100vh - 100rpx);
}

.activity-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.card-disabled {
  opacity: 0.7;
  background: #f9f9f9;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-active {
  background: #e6f7ff;
  color: #1890ff;
}

.status-ended {
  background: #f5f5f5;
  color: #999;
}

.card-body {
  margin-bottom: 20rpx;
}

.info-row {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.card-footer {
  text-align: right;
}

.arrow-right {
  color: #ccc;
}