page {
  background: #F8F9FA;
  --theme-red: #D84315; /* 品牌色：砖红/橙红 */
  --theme-blue: #007AFF; /* 辅助色：现代蓝 */
  --bg-card: #FFFFFF;
  --text-main: #333333;   /* 标题深灰 */
  --text-body: #666666;   /* 正文中灰 */
  --text-sub: #999999;    /* 辅助浅灰 */
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.calendar-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 日历容器：卡片质感 */
.calendar-card-container {
  margin: 20rpx 30rpx;
  background: var(--bg-card);
  border-radius: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

/* 头部导航 */
.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 20rpx;
}

.month-nav {
  display: flex;
  align-items: center;
  color: var(--text-sub);
  font-size: 26rpx;
  padding: 10rpx;
}

.nav-arrow {
  font-size: 24rpx;
  margin: 0 8rpx;
}

.current-month-title {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.calendar-header .month-num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-left: 12rpx;
}

.calendar-header .year-num {
  font-size: 30rpx;
  color: var(--text-sub);
  font-weight: 500;
}

/* 星期条 */
.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 20rpx 20rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 600;
}

/* 日历网格与动画 */
.calendar-grid-wrapper {
  overflow: hidden;
  position: relative;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 10rpx 20rpx 30rpx;
  box-sizing: border-box;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.slide-left { transform: translateX(-100%); }
.slide-right { transform: translateX(100%); }

.day-cell {
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 32rpx; /* 圆角加大 */
  margin: 6rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.day-num {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-main);
}

.prev .day-num, .next .day-num {
  color: #E0E0E0;
}

/* 选中态：发光与缩放 */
.selected {
  background: var(--theme-red);
  transform: scale(1.08);
  box-shadow: 0 10rpx 24rpx rgba(216, 67, 21, 0.3);
}

.selected .day-num {
  color: #ffffff;
  font-weight: 700;
}

/* 活动圆点：与选中色一致 */
.activity-dot {
  width: 8rpx;
  height: 8rpx;
  background: var(--theme-red);
  border-radius: 50%;
  position: absolute;
  bottom: 15%;
}

.selected .activity-dot {
  background: rgba(255, 255, 255, 0.8);
}

/* 活动区域 */
.activity-section {
  flex: 1;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-left: 10rpx;
}

.title-line {
  width: 8rpx;
  height: 32rpx;
  background: var(--theme-blue); /* 辅助色蓝 */
  border-radius: 4rpx;
  margin-right: 18rpx;
}

.section-title text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* 活动卡片入场动画 */
.activity-item {
  display: flex;
  background: #fff;
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(0,0,0,0.02);
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.03);
  transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.activity-item:active {
  transform: scale(0.9);
}


.activity-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.activity-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.activity-meta {
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-body);
  margin-bottom: 12rpx;
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

/* 详情按钮：渐变与质感 */
.go-btn {
  align-self: flex-start;
  background: linear-gradient(135deg, #444, #222);
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border-radius: 20rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.1);
}

/* 空状态 */
.empty-activities {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
}

.empty-img {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
  opacity: 0.2;
}

.empty-activities text {
  font-size: 28rpx;
  color: var(--text-sub);
}
