<view class="container">
  <form bindsubmit="onSaveProfile">
    <view class="form-group">
      <view class="form-item avatar-item">
        <text class="label">头像</text>
        <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill"></image>
        </button>
      </view>
      
      <view class="form-item">
        <text class="label">姓名</text>
        <input type="nickname" name="name" class="input" placeholder="请输入真实姓名" value="{{userInfo.nickName || userInfo.name}}" bindinput="onInputChange" data-field="name" />
      </view>

      <view class="form-item">
        <text class="label">性别</text>
        <picker bindchange="onGenderChange" value="{{genderIndex}}" range="{{genders}}">
          <view class="picker">
            {{userInfo.gender || '请选择性别'}}
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="label">学院</text>
        <input class="input" name="college" placeholder="请输入学院" value="{{userInfo.college}}" bindinput="onInputChange" data-field="college" />
      </view>

      <view class="form-item">
        <text class="label">专业班级</text>
        <input class="input" name="majorClass" placeholder="例：大数据242" value="{{userInfo.majorClass}}" bindinput="onInputChange" data-field="majorClass" />
      </view>

      <view class="form-item">
        <text class="label">学号</text>
        <input class="input" name="studentId" type="number" placeholder="请输入学号" value="{{userInfo.studentId}}" bindinput="onInputChange" data-field="studentId" />
      </view>

      <view class="form-item">
        <text class="label">手机号</text>
        <input class="input" name="phoneNumber" type="number" placeholder="请输入手机号" value="{{userInfo.phoneNumber}}" bindinput="onInputChange" data-field="phoneNumber" />
      </view>

      <view class="form-item">
        <text class="label">政治面貌</text>
        <picker bindchange="onPoliticalStatusChange" value="{{politicalIndex}}" range="{{politicalStatuses}}">
          <view class="picker">
            {{userInfo.politicalStatus || '请选择'}}
          </view>
        </picker>
      </view>

      <view class="form-item column-item">
        <text class="label">特长</text>
        <textarea class="textarea" name="specialty" placeholder="请输入个人特长" value="{{userInfo.specialty}}" bindinput="onInputChange" data-field="specialty" auto-height />
      </view>
    </view>

    <view class="tips">
      <text>请务必填写真实信息，以便活动报名审核</text>
    </view>

    <button class="save-btn" form-type="submit">保存修改</button>
  </form>
</view>