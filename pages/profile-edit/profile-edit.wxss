.container {
  padding: 30rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 120rpx; /* Space for bottom button */
}

.form-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
  min-height: 60rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.column-item {
  flex-direction: column;
  align-items: flex-start;
}

.label {
  font-size: 30rpx;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.avatar-wrapper {
  padding: 0;
  width: 100rpx !important;
  height: 100rpx !important;
  border-radius: 50%;
  background: none;
  border: none;
  margin: 0;
  margin-left: auto;
  display: flex;
  justify-content: center;
  align-items: center;
}

.avatar-wrapper::after {
  border: none;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: block;
}

.input {
  text-align: right;
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.picker {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #333;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  color: #333;
  margin-top: 20rpx;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.tips {
  margin-top: 30rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 60rpx;
}

.save-btn {
  width: 90% !important;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  padding: 24rpx 0;
  border-radius: 44rpx;
  margin: 0 auto;
  display: block;
}

.save-btn::after {
  border: none;
}