<scroll-view scroll-y="true" style="height: 100vh;">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navHeight}}px; padding-top:{{statusBarHeight}}px;">
    <view class="nav-content" style="top:{{navTop}}px; left:{{navLeft}}px;">
      <text class="nav-brand">和美公益</text>
    </view>
  </view>

  <view class="swiper-wrapper {{showEntrance ? 'entrance-fade-in' : 'initial-state'}}" style="margin-top: 30rpx; animation-delay: 0ms;">
    <swiper class="banner-swiper" indicator-dots="{{false}}" autoplay="true" interval="5000" duration="500" circular="{{banners.length > 1}}" bindchange="onSwiperChange">
      <block wx:for="{{banners}}" wx:key="url">
        <swiper-item>
          <view class="slide-container" bindtap="onBannerTap" data-link="{{item.link}}">
            <image src="{{item.url}}" mode="aspectFill" class="slide-image"></image>
            <view class="banner-caption">
              <view class="tag-hot" wx:if="{{item.tag || '往期精彩'}}">{{item.tag || '往期精彩'}}</view>
              <view class="banner-title">{{item.title || ''}}</view>
              <view class="banner-subtitle">{{item.subtitle || ''}}</view>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
    
    <!-- 自定义始终显示的背景装饰 (可选，根据图片效果) -->
  </view>

  <!-- 自定义指示点 - 放在图片下方 -->
  <view class="swiper-dots-below">
    <block wx:for="{{banners}}" wx:key="url" wx:for-index="index">
      <view class="dot {{index === swiperCurrent ? 'active' : ''}}"></view>
    </block>
  </view>

  <!-- 搜索和筛选 -->
  <view class="unified-search-unit {{showEntrance ? 'entrance-fade-in' : 'initial-state'}} {{searchFocused ? 'search-unit-focused' : ''}}" style="animation-delay: 100ms;">
    <block wx:if="{{isAuthorized}}">
      <picker bindchange="onCategoryChange" value="{{categoryIndex}}" range="{{categories}}">
        <view class="category-btn" hover-class="category-btn-hover">
          <text>{{categories[categoryIndex] || '全部'}}</text>
          <text class="arrow-tiny">▾</text>
        </view>
      </picker>
    </block>
    <block wx:else>
      <view class="category-btn" hover-class="category-btn-hover" catchtap="forceLoginAction">
        <text>{{categories[categoryIndex] || '全部'}}</text>
        <text class="arrow-tiny">▾</text>
      </view>
    </block>

    <view class="vertical-divider"></view>

    <view class="search-bar-new">
      <block wx:if="{{isAuthorized}}">
        <input class="search-input-new" placeholder="搜索活动..." bindinput="onSearchInput" bindconfirm="executeSearch" bindfocus="onSearchFocus" bindblur="onSearchBlur" />
        <image class="search-icon-small" src="/images/search.svg" bindtap="executeSearch"></image>
      </block>
      <block wx:else>
        <input class="search-input-new" disabled placeholder="搜索活动..." catchtap="forceLoginAction" />
        <image class="search-icon-small" src="/images/search.svg" catchtap="forceLoginAction"></image>
      </block>
    </view>
  </view>

  <!-- 路线/活动列表 -->
  <view class="route-list">
    
    <!-- 无数据状态 -->
    <view wx:if="{{!loading && filteredRoutes.length === 0}}" class="empty-state {{showEntrance ? 'entrance-fade-in' : 'initial-state'}}" style="animation-delay: 200ms;">
      <view class="empty-icon-container">
        <image class="empty-calendar-icon" src="/images/calendar.svg"></image>
      </view>
      <view class="empty-title">
        <block wx:if="{{submittedSearchQuery}}">哎呀，没有找到与“{{submittedSearchQuery}}”相关的活动</block>
        <block wx:else>当前暂无活动</block>
      </view>
      <view class="empty-desc">
        <block wx:if="{{submittedSearchQuery}}">换个关键词试试看吧，期待能为您找到合适的活动~</block>
        <block wx:else>目前没有正在进行的{{activeTab === 'volunteer' ? '志愿服务' : '研学活动'}}，关注我们，第一时间获取最新资讯。</block>
      </view>
    </view>
    
    <!-- 列表项 -->
    <view wx:else>
      <view 
        wx:for="{{filteredRoutes}}" 
        wx:key="_id" 
        class="activity-card {{showEntrance ? 'entrance-fade-in' : 'initial-state'}}" 
        style="animation-delay: {{index * 100 + 200}}ms"
        hover-class="card-press-feedback" 
        bindtap="goToDetail" 
        data-id="{{item._id || item.id}}"
      >
        <view class="card-header">
          <text class="card-title">{{item.title}}</text>
          <text class="card-category">分类: {{item.category}}</text>
        </view>
        <view class="card-body">
          <view class="info-row">时间: {{item.start_date || item.time}}</view>
          <view class="info-row">地点: {{item.location || item.place || '待定'}}</view>
          <view class="info-row">人数: {{item.current_count || 0}}/{{item.quota}}</view>
        </view>
        <view class="card-footer">
          <text class="arrow-right">></text>
        </view>
      </view>
    </view>
  </view>

  <view style="height: 80rpx;"></view>
</scroll-view>

<!-- 报名弹窗 (保留原有逻辑，但可能需要调整触发方式) -->
<view wx:if="{{showSignup}}" class="signup-modal">
  <view class="modal-content">
    <view class="modal-title">报名</view>
    <form bindsubmit="submitSignup">
      <view class="form-item">
        <text class="form-label">孩子姓名：</text>
        <input class="form-input" name="childName" placeholder="请输入孩子姓名" value="{{signupForm.childName}}" />
      </view>
      <view class="form-item">
        <text class="form-label">性别：</text>
        <radio-group class="form-radio-group" name="childGender">
          <label><radio value="男" checked="{{signupForm.childGender === '男'}}"/>男</label>
          <label><radio value="女" checked="{{signupForm.childGender === '女'}}"/>女</label>
        </radio-group>
      </view>
      <view class="form-item">
        <text class="form-label">年龄：</text>
        <input class="form-input" name="childAge" type="number" placeholder="请输入年龄" value="{{signupForm.childAge}}" />
      </view>
      <view class="form-item">
        <text class="form-label">家长手机：</text>
        <input class="form-input" name="parentPhone" type="number" placeholder="请输入手机号" value="{{signupForm.parentPhone}}" />
      </view>
      <view class="form-actions">
        <button class="submit-btn" form-type="submit">提交报名</button>
        <button class="cancel-btn" bindtap="closeSignup">取消</button>
      </view>
    </form>
  </view>
</view>

<!-- 外部链接引导弹窗 -->
<view wx:if="{{showBrowserGuide}}" class="browser-guide-overlay" catchtap="closeBrowserGuide" catchtouchmove="preventBubbling">
  <view class="browser-guide-modal" catchtap="preventBubbling">
    <view class="guide-header">
      <text class="guide-title">外部链接访问</text>
    </view>
    <view class="guide-content">
      <view class="guide-icon">🌐</view>
      <view class="guide-text">由于微信环境安全限制，该网页无法直接打开。请复制下方链接后，在手机自带浏览器中粘贴访问：</view>
      <view class="guide-link-box">
        <text class="guide-link-text" user-select="true">{{currentExternalLink}}</text>
      </view>
    </view>
    <view class="guide-actions">
      <view class="guide-btn btn-cancel" catchtap="closeBrowserGuide">取消</view>
      <view class="guide-btn btn-confirm" catchtap="copyExternalLink">复制链接并去浏览器</view>
    </view>
  </view>
</view>
