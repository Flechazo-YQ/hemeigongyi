/* pages/index/index.wxss */

page {
  background-color: #ffffff;
  padding-bottom: 40rpx;
}

/* 通用标题样式 */
.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-right: 30rpx;
}

.more-link {
  font-size: 26rpx;
  color: #999;
}

.section-header {
  font-size: 32rpx;
  font-weight: bold;
  color: #000;
  padding: 30rpx 30rpx 20rpx;
  display: flex;
  align-items: center;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 350rpx;
  margin: 0;
  border-radius: 0;
  overflow: hidden;
  box-shadow: none;
}

.slide-image {
  width: 100%;
  height: 100%;
}

.slide-placeholder {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffefe;
  font-size: 30rpx;
}

/* 报名入口按钮 */
.entry-buttons {
  display: flex;
  justify-content: space-between;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.entry-btn {
  width: 330rpx;
  height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  border: 1rpx solid #e0e0e0;
  background: #fff;
  color: #333;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.05);
  transition: all 0.3s ease;
}

.entry-btn:active {
  transform: translateY(4rpx);
  box-shadow: none;
}

/* 激活状态样式 */
.volunteer-btn.active,
.study-btn.active {
  background: #E6E6FA; /* 统一淡紫色背景 */
  color: #000; /* 黑字 */
  border-color: #E6E6FA;
  box-shadow: 0 4rpx 12rpx rgba(230, 230, 250, 0.4);
}

/* 搜索和筛选 */
.search-filter-bar {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.search-box {
  flex: 1;
  height: 70rpx;
  background: #ffffff;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  margin-right: 20rpx;
  border: 1rpx solid #e0e0e0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.filter-dropdown {
  height: 70rpx;
  background: #ffffff;
  border-radius: 35rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #e0e0e0;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.search-icon {
  font-size: 32rpx;
  color: #333;
}

.arrow-down {
  margin-left: 10rpx;
  font-size: 24rpx;
}

/* 列表样式 */
.route-list {
  padding: 0 30rpx;
}

.loading, .no-data {
  text-align: center;
  padding: 50rpx 0;
  color: #999;
  font-size: 28rpx;
}

.activity-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  color: #333;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  border: 1rpx solid #f0f0f0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  flex: 1;
  margin-right: 20rpx;
}

.card-category {
  font-size: 24rpx;
  color: #555;
}

.card-body {
  margin-bottom: 20rpx;
}

.info-row {
  font-size: 26rpx;
  margin-bottom: 8rpx;
  color: #444;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.hint-text {
  font-size: 24rpx;
  color: #333;
  margin-right: 10rpx;
}

.arrow-right {
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1;
}

/* 报名弹窗 (保留原有样式) */
.signup-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 600rpx;
}

.modal-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  padding: 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-radio-group {
  display: flex;
  gap: 30rpx;
}

.form-radio-group label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.submit-btn, .cancel-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.submit-btn {
  background: #007aff;
  color: #fff;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

