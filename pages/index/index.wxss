page {
  --theme-color: #A62F39; /* 优雅不鲜艳的红 */
  --theme-bg-light: #FDF1F2; /* 极浅红背景 */
  --theme-border: #F5E0E1; /* 浅红边框 */
  padding-bottom: 20rpx;
  background: radial-gradient(circle at center, #FDF1F2 0%, #FFFFFF 100%);
  min-height: 100vh;
}

/* 自定义导航栏样式 */
.custom-nav {
  position: relative;
  width: 100%;
  background: transparent;
  z-index: 999;
}

.nav-content {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  height: 32px; /* Matches average capsule height */
}

.nav-logo {
  width: 38rpx;
  height: 38rpx;
  margin-right: 12rpx;
}

.nav-brand {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 2rpx;
}

/* 页面大标题 */
.page-main-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--theme-blue);
  padding: 20rpx 30rpx 10rpx;
  letter-spacing: 2rpx;
}

/* 通用标题样式 */
.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 20rpx 30rpx 10rpx;
}

.title-container {
  display: flex;
  align-items: stretch;
}

.vertical-marker {
  width: 8rpx;
  background-color: var(--theme-color);
  border-radius: 4rpx;
  margin-right: 16rpx;
  margin-top: 6rpx;
  margin-bottom: 6rpx;
}

.title-text-group {
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.section-subtitle {
  font-size: 22rpx;
  color: #999999;
  line-height: 1.2;
}

.more-link {
  font-size: 24rpx;
  color: var(--theme-color);
  font-weight: 600;
  margin-bottom: 6rpx;
}

/* 轮播图增强 */
.swiper-wrapper {
  position: relative;
  width: 100%;
  margin-top: 10rpx;
}

/* 往期精彩标题 */
.section-header {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx 10rpx;
}

.section-header .title-line {
  width: 8rpx;
  height: 32rpx;
  background: #D84315;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-header .title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.banner-swiper {
  width: 690rpx;
  height: 388rpx;
  margin: 0 auto;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
}

.slide-container {
  position: relative;
  width: 100%;
  height: 100%;
}

.slide-image {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
  display: block;
}

.banner-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 30rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
  pointer-events: none;
  z-index: 11;
}

.tag-hot {
  display: inline-block;
  background: #A62F39;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  /* 黑色描边效果 */
  text-shadow: 2rpx 2rpx 0 #000, -2rpx -2rpx 0 #000, 2rpx -2rpx 0 #000, -2rpx 2rpx 0 #000;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.banner-subtitle {
  font-size: 26rpx;
  color: #fff;
  /* 黑色描边效果 */
  text-shadow: 1rpx 1rpx 0 #000, -1rpx -1rpx 0 #000, 1rpx -1rpx 0 #000, -1rpx 1rpx 0 #000;
  opacity: 0.95;
}

.swiper-dots-below {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  margin-bottom: 10rpx;
}

.swiper-dots-below .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d1d9e6;
  transition: all 0.3s ease;
}

.swiper-dots-below .dot.active {
  width: 48rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #A62F39;
}

/* 统一搜索和筛选码头 */
.unified-search-unit {
  display: flex;
  align-items: center;
  background: #ffffff;
  margin: 40rpx 30rpx 40rpx;
  height: 96rpx;
  border-radius: 24rpx;
  padding: 0 30rpx 0 10rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.search-bar-new {
  flex: 1;
  display: flex;
  align-items: center;
}

.search-icon-small {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  opacity: 0.6;
}

.search-input-new {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.vertical-divider {
  width: 1rpx;
  height: 36rpx;
  background: #d1d9e6;
  margin: 0 20rpx;
}

.category-btn {
  height: 68rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #4a5568;
  font-weight: 500;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.category-btn:active {
  background: rgba(0,0,0,0.05);
}

.arrow-tiny {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #a0aec0;
}

/* 列表样式 */
.route-list {
  padding: 0 30rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  text-align: center;
}

.empty-icon-container {
  width: 140rpx;
  height: 140rpx;
  background: transparent;
  border: 2rpx solid #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.empty-calendar-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
}

.activity-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  color: #333;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f8f8f8;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  flex: 1;
}

.card-category {
  font-size: 22rpx;
  color: var(--theme-color);
  background: var(--theme-bg-light);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.card-body {
  margin-bottom: 0;
}

.info-row {
  font-size: 26rpx;
  margin-bottom: 12rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.info-row:last-child {
  margin-bottom: 0;
}

.card-footer {
  display: none; /* 移除旧的箭头，或者改用更精致的设计 */
}

/* 报名弹窗 (保留原有样式) */
.signup-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 600rpx;
}

.modal-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  padding: 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-radio-group {
  display: flex;
  gap: 30rpx;
}

.form-radio-group label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.submit-btn, .cancel-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.submit-btn {
  background: #007aff;
  color: #fff;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

/* --- 入场动画与微交互 --- */

@keyframes slideUpFade {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes fadeInLeftElastic {
  0% {
    transform: translateX(-40rpx);
    opacity: 0;
  }
  60% {
    transform: translateX(10rpx);
    opacity: 1;
  }
  100% {
    transform: translateX(0);
    opacity: 1;
  }
}

.initial-hidden {
  opacity: 0;
}

.entrance-slide-up {
  animation: slideUpFade 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}

.entrance-fade-in-left {
  animation: fadeInLeftElastic 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
  animation-delay: 0.2s;
}

.entrance-stagger-item {
  animation: slideUpFade 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}

/* 搜索栏浮起 */
.search-unit-focused {
  transform: translateY(-6rpx);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.1) !important;
  transition: all 0.3s ease;
}

.unified-search-unit {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Banner 交互 */
.banner-arrow-hover {
  transform: scale(1.15);
  background: rgba(255, 255, 255, 0.4) !important;
  transition: all 0.2s ease;
}

.slide-image {
  transition: transform 0.4s ease;
}

/* 分类按钮反馈 */
.category-btn {
  transition: all 0.2s ease;
}

.category-btn-hover {
  background: rgba(0, 0, 0, 0.05);
  color: var(--theme-color);
}

/* 活动卡片按压反馈 */
.activity-card {
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); /* Added springier cubic-bezier */
}

.card-press-feedback {
  transform: scale(0.9) translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05) !important;
  background-color: #fcfcfc !important;
}

/* 这里模拟按压后的回弹（配合 hover-class） */
.activity-card:active {
  transform: scale(0.9);
}

/* 外部链接引导弹窗 */
.browser-guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

.browser-guide-modal {
  background: #fff;
  border-radius: 24rpx;
  width: 80%;
  max-width: 600rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.1);
  animation: slideUpFade 0.3s ease;
}

.guide-header {
  padding: 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.guide-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.guide-content {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.guide-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}

.guide-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.guide-link-box {
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
  word-break: break-all;
  border: 1rpx dashed #d1d9e6;
}

.guide-link-text {
  font-size: 24rpx;
  color: #4a5568;
}

.guide-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.guide-btn {
  flex: 1;
  padding: 30rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  transition: background 0.2s;
}

.guide-btn:active {
  background: #f5f5f5;
}

.btn-cancel {
  color: #999;
  border-right: 1rpx solid #f0f0f0;
}

.btn-confirm {
  color: var(--theme-color, #A62F39);
  font-weight: bold;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

