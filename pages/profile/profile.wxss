.profile-container {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-bottom: 200rpx;
}

/* --- Header Section --- */
.top-card-wrap {
  margin: 24rpx 30rpx 40rpx;
  background: linear-gradient(135deg, #A62F39, #C8424E);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(166, 47, 57, 0.2);
  overflow: hidden;
  position: relative;
}

.user-header-new {
  background: transparent;
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.admin-toggle-btn-top {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 44rpx;
  height: 44rpx;
  z-index: 100;
  padding: 10rpx; /* Increase tap area */
  filter: brightness(0) invert(1);
}

.avatar-block {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin-right: 30rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 0 4rpx rgba(255,255,255,0.8), 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.avatar-large {
  display: block;
  width: 100%;
  height: 100%;
}



/* Unified Standard Icon Class */
.svg-icon, 
.svg-icon-red, 
.svg-icon-blue, 
.svg-icon-green, 
.svg-icon-purple,
.logout-icon-small {
  width: 36rpx;
  height: 36rpx;
  /* Brand Red Filter (#A62F39) for uniform color */
  filter: invert(27%) sepia(51%) saturate(2878%) hue-rotate(338deg) brightness(88%) contrast(92%);
}

.user-main-info {
  flex: 1;
}

.name-row-new {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.nickname-new {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.name-placeholder {
  color: rgba(255, 255, 255, 0.6) !important;
  font-weight: 400;
}

.badge-role {
  background: #fff0f0;
  color: #A62F39;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.badge-role-admin {
  background: #E8F3FF;
  color: #1989FA;
}

.sub-text-new {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.arrow-right-new {
  color: rgba(255, 255, 255, 0.6);
  font-size: 32rpx;
}

/* --- Stats Board --- */
.stats-board {
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  padding: 36rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stats-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  margin-top: 10rpx;
}

/* --- Content Body --- */
.content-body-new {
  padding: 0 30rpx;
}

.menu-list-new {
  margin-bottom: 60rpx;
}

.menu-card-new {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.menu-inner {
  display: flex;
  align-items: center;
}

.icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-wrap image {
  width: 32rpx;
  height: 32rpx;
}

.menu-group-title-new {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 0 20rpx 10rpx;
  letter-spacing: 2rpx;
}

.icon-bg-red { background: #fff0f0; }
.icon-bg-pink { background: #fff3f5; }
.icon-bg-light-red { background: #fff5f5; }
.icon-bg-blue-new { background: #e6f7ff; }
.icon-bg-green-new { background: #f6ffed; }
.icon-bg-purple-new { background: #f9f0ff; }
.icon-bg-orange-new { background: #fff7e6; }

/* Arrow consistency */
.card-arrow, .arrow-right-new {
  color: #d1d1d1;
  font-size: 28rpx;
}

.menu-label-new {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.emoji-menu-icon, .emoji-logout {
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* --- Logout --- */
.logout-wrap {
  margin-top: 40rpx;
}

.logout-btn-new {
  background: #ffffff;
  border: none;
  border-radius: 20rpx;
  padding: 30rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 500;
  width: 100% !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.logout-icon-small {
  width: 36rpx;
  height: 36rpx;
}

.card-hover {
  background: #fafafa;
}

/* --- Login Prompt & Modals --- */
.login-prompt {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  z-index: 10001;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.logo { width: 220rpx; height: 220rpx; margin-bottom: 40rpx; }
.prompt-title { font-size: 38rpx; font-weight: bold; margin-bottom: 16rpx; text-align: center; }
.prompt-desc { font-size: 26rpx; color: #999; margin-bottom: 80rpx; text-align: center; }

.login-btn-red {
  width: 580rpx;
  background-color: #A62F39;
  color: white;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 600;
}

.agreement-text { font-size: 22rpx; color: #ccc; margin-top: 40rpx; text-align: center; width: 580rpx; }

.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9000;
}

.modal-content {
  width: 620rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 50rpx;
}

.modal-header { font-size: 34rpx; font-weight: bold; margin-bottom: 40rpx; text-align: center; }

.avatar-container {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 40rpx;
}

.avatar-wrapper {
  width: 140rpx !important;
  height: 140rpx !important;
  min-height: 0 !important;
  border-radius: 50% !important;
  margin: 0 !important;
  padding: 0 !important;
  position: relative;
  overflow: hidden;
  background: #f0f0f0;
  line-height: 140rpx;
  box-sizing: border-box;
}
.avatar-wrapper::after { border: none; }

.avatar-preview {
  display: block;
  width: 140rpx;
  height: 140rpx;
}

.camera-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: #A62F39;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(166, 47, 57, 0.3);
}

.edit-icon-small {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) invert(1);
}

.input-container {
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
}

.label { font-size: 28rpx; color: #666; width: 140rpx; }
.name-input { font-size: 28rpx; color: #333; flex: 1; }

.submit-btn {
  margin-top: 50rpx;
  background: #A62F39;
  color: #fff;
  border-radius: 40rpx;
  font-weight: 600;
  width: 100% !important;
  box-shadow: 0 4rpx 20rpx rgba(166, 47, 57, 0.2);
}
