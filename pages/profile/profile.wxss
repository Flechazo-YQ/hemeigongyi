page {
  background-color: #F7F8FA;
}

.profile-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* User Card Section */
.user-card-section {
  background: #FFFFFF;
  padding: 30rpx 30rpx 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.admin-toggle-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 48rpx;
  height: 48rpx;
  z-index: 10;
}

.user-info-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
}

.avatar-wrapper {
  position: relative;
  margin-right: 32rpx;
  flex-shrink: 0;
  margin-top: 45rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 2rpx solid #f0f0f0;
  display: block;
}

.info-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0; /* Prevent flex item overflow */
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.nickname-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300rpx;
}

.user-type-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  line-height: 1.2;
  display: inline-flex;
  align-items: center;
}

.badge-admin {
  background: #E8F3FF;
  color: #1989FA;
}

.badge-user {
  background: #F0F9EB;
  color: #07C160;
}

.edit-hint {
  font-size: 24rpx;
  color: #999;
}

.edit-hint.incomplete {
  color: #FA5151; /* Red color for incomplete status */
  font-weight: 500;
}

.arrow-icon {
  color: #Ccc;
  font-size: 32rpx;
}

/* Content Body */
.content-body {
  padding: 0 30rpx;
}

.menu-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.02);
}

.menu-group-title {
  font-size: 28rpx;
  color: #999;
  padding: 30rpx 0 10rpx;
  font-weight: 500;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F5F6F8;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-box {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
}

/* Icon Colors */
.icon-publish-vol { background: #FF9C6E; }
.icon-publish-study { background: #5CDBD3; }
.icon-manage-vol { background: #69C0FF; }
.icon-list-vol { background: #95DE64; }
.icon-list-study { background: #B37FEB; }
.icon-my-signup { background: #FFC069; }

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.arrow {
  color: #ccc;
  font-size: 28rpx;
}

.logout-btn {
  background: #FFFFFF;
  color: #FA5151;
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-weight: 500;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.02);
}

.logout-btn::after {
  border: none;
}

