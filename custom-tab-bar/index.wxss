/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: none;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  font-size: 20rpx;
}

.tab-icon {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 6rpx;
}

.tab-bar-item.active .tab-text {
  font-weight: 600;
}

.tab-bar-item.active .tab-icon {
  filter: invert(20%) sepia(85%) saturate(2158%) hue-rotate(338deg) brightness(91%) contrast(92%);
}

.tab-icon.ai-research-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 0;
}
