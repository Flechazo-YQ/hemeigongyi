/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #eee;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  font-size: 20rpx;
}

.tab-icon {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 6rpx;
}

.tab-bar-item.active .tab-text {
  font-weight: 600;
}

.tab-icon.ai-research-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 0;
}
